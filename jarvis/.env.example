# JARVIS configuration. Copy to .env at the workspace root and fill in.
# The real .env is gitignored — never commit it.

# --- Brain: pick ONE provider ---
# anthropic = paid, full tool use + web search (the default)
# cerebras  = free, gpt-oss-120b on very fast silicon, plain chat only
# ollama    = free, local machine or Ollama Cloud, plain chat only
# Both free paths skip tool use: no reminders, no web search, no delegation.
LLM_PROVIDER=anthropic

# Required unless LLM_PROVIDER is set to a free provider:
ANTHROPIC_API_KEY=sk-ant-...          # https://platform.claude.com/settings/keys

# Cerebras free tier: 30 req/min, 14,400 req/day, 1M tokens/day (as of 2026-07-24)
CEREBRAS_API_KEY=                      # https://cloud.cerebras.ai/ -> API Keys
CEREBRAS_MODEL=gpt-oss-120b            # or llama3.1-8b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Ollama: leave OLLAMA_API_KEY empty for a local server; set it for Ollama Cloud
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_HOST=                         # defaults to localhost, or ollama.com if a key is set

# --- Voice output (optional; without it, replies are text only) ---
ELEVENLABS_API_KEY=                    # https://elevenlabs.io
JARVIS_VOICE_ID=                       # a voice id from your ElevenLabs account
JARVIS_TTS_ENABLED=true
JARVIS_TTS_MODEL=eleven_flash_v2_5     # lowest-latency ElevenLabs model

# --- Voice input (optional; without it, falls back to ElevenLabs Scribe) ---
DEEPGRAM_API_KEY=                      # https://deepgram.com — streaming STT,
                                        # much lower latency than record-then-upload

# --- Behaviour (all optional; sensible defaults shown) ---
JARVIS_NAME=Jarvis
JARVIS_WAKE_WORDS=jarvis,hey jarvis
JARVIS_MODEL=claude-sonnet-5           # conversational brain
JARVIS_HEAVY_MODEL=claude-fable-5      # reserved for hard reasoning / delegation
JARVIS_MAX_TOKENS=4096
JARVIS_MAX_HISTORY_PAIRS=12            # conversation turns kept in context
JARVIS_STT_LANGUAGE=auto               # or e.g. en-US, hi-IN

# --- Storage (optional; defaults under jarvis/data/) ---
# JARVIS_DATA_DIR=
# JARVIS_DB_PATH=
# JARVIS_LOG_PATH=
