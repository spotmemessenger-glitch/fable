# Postgres (Neon) — see spotme/web's PUSH.md pattern: keys live in the host's
# env panel (Railway/Fly), never committed.
DATABASE_URL="postgresql://user:password@host/spotme?sslmode=require"

# Auth
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# OTP delivery (email channel to start — swap in an SMS provider later)
OTP_FROM_EMAIL="noreply@spotmemessenger.app"
RESEND_API_KEY=""

# Existing Cloudflare account (already used for TURN) — same login, new bucket.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="spotme-media"

# StorageProvider port (src/storage/storage.interface.ts → IStorageAdapter).
# STORAGE_PROVIDER selects the adapter: 'local' (default) or 's3'. The 's3'
# adapter is S3-COMPATIBLE and swappable by config alone — point it at AWS S3,
# Cloudflare R2, Backblaze B2, or a local MinIO by changing only these values:
#   - R2/MinIO/Backblaze need path-style addressing (auto-on when S3_ENDPOINT is
#     set, or force with S3_FORCE_PATH_STYLE=true).
#   - Leave S3_ENDPOINT empty for real AWS S3.
STORAGE_PROVIDER="local"
S3_ENDPOINT=""              # e.g. https://<acct>.r2.cloudflarestorage.com (R2), https://s3.<region>.backblazeb2.com (B2), http://localhost:9000 (MinIO)
S3_REGION="auto"           # 'auto' for R2; a real region for S3/B2
S3_BUCKET="spotme-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false" # true for MinIO/R2 if not already implied by S3_ENDPOINT

# Push.
#
# FIREBASE_SERVICE_ACCOUNT is the name the code actually reads
# (src/push/push.service.ts). It was documented here as
# FCM_SERVICE_ACCOUNT_JSON — a name NOTHING in the repo reads — so anyone
# provisioning push from this file alone set a variable with no consumer and
# got a silently dead FCM leg: initFirebase() returns before its try/catch,
# so there is no warning either. Accepts a service-account JSON blob, the
# same JSON base64-encoded (Railway env vars dislike newlines), or a path.
FIREBASE_SERVICE_ACCOUNT=""
APNS_KEY_ID=""
APNS_TEAM_ID=""

# Web push (VAPID) — read by src/push/push.service.ts. Absent these,
# GET /api/push reports enabled:false and the client never offers push.
# VAPID_SUBJECT defaults to a mailto: for the project when unset.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Age verification vendor (Nearby/Discovery gate only) — optional at launch
AGE_VERIFY_PROVIDER=""
AGE_VERIFY_API_KEY=""

# Observability baseline (src/observability/) — EVERY leg is a no-op when its
# variable is unset; with a clean env nothing changes about how the app runs.
# The DSN/endpoint values are never logged; structured logs redact secrets,
# coordinates, message content, and connection strings (see json-logger.ts).
LOG_FORMAT=""                    # "json" enables structured JSON logging
METRICS_ENABLED=""               # "true" enables the prom-client registry
SENTRY_DSN=""                    # set + install @sentry/node to enable Sentry
OTEL_EXPORTER_OTLP_ENDPOINT=""   # set + install @opentelemetry/sdk-node to enable OTel
OTEL_SERVICE_NAME=""             # defaults to spotme-backend
SENTRY_TRACES_SAMPLE_RATE=""     # 0..1; unset means Sentry tracing stays off

# Realtime data plane (ADR-026, Centrifugo). realtime.controller.ts answers
# 503 until all three are set — the control plane (Socket.IO) is unaffected.
CENTRIFUGO_API_URL=""
CENTRIFUGO_API_KEY=""
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=""

# Calls (ADR-033 server-only transport): LiveKit issues call media tokens.
# Absent these, the call path reports itself unavailable rather than failing
# mid-call.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Search (Typesense, selected in Phase 2 — NOT wired into the app yet).
# Unconfigured by default; the adapter reports unavailable.
#
# TYPESENSE_URL is assigned BARE, with no "" — deliberately. The Discovery
# dark fence (test/discovery-dark-fences.spec.ts) asserts .env.example never
# pre-fills a Typesense endpoint, and its regex treats anything after the `=`
# — including an empty pair of quotes — as pre-filling. Documenting the name
# and shipping the feature dark are both requirements, and a bare `=` is the
# form that satisfies both. Do not "tidy" this into ="".
TYPESENSE_URL=
TYPESENSE_API_KEY=""

# Queues (BullMQ on ioredis). Unset disables the {maintenance} queue and every
# reserved Moments queue — the modules are inert without it.
REDIS_URL=""

# Keyset-cursor signing, one per platform surface. Each is OPTIONAL and must be
# >= 16 chars to be accepted; without one the process mints a random key at
# boot, so cursors simply do not survive a restart. That is correct for a dark
# feature and NOT correct once a surface is activated — set them at activation
# or paging breaks across deploys.
DISCOVERY_CURSOR_SECRET=""
EXCHANGE_CURSOR_SECRET=""
EVENTS_CURSOR_SECRET=""
MOMENTS_CURSOR_SECRET=""

# Local storage adapter (STORAGE_PROVIDER="local"). STORAGE_URL_SECRET signs
# local media URLs — it is what makes such a URL a credential. It falls back to
# JWT_ACCESS_SECRET and then to a HARDCODED dev string, so any deployment
# serving media from the local adapter should set it explicitly.
STORAGE_LOCAL_DIR=""
STORAGE_LOCAL_BASE_URL=""
STORAGE_URL_SECRET=""

# Child-safety reporting (NCMEC). Unset leaves the reporting leg inert; the
# moderation machine still records and escalates internally.
NCMEC_API_KEY=""

# Absolute origin this API is reachable at, used where a generated link cannot
# be relative. Unset falls back to the request's own host.
PUBLIC_API_ORIGIN=""

# Employee seed (scripts/seed-employee). Development and first-boot only —
# never set these in a long-lived production environment.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
SEED_ADMIN_PASSWORD=""

# Where the bridged spotme/web/api/* handlers are read from. Defaults to the
# repo-relative ../web/api; the deployed image lays them out differently, and
# getting it wrong is silent (every /api/* route simply 404s).
WEB_API_DIR=""

# Activation Wave 0 / Wave 1A rehearsal switches. All default OFF; they gate
# seeding and benchmark harnesses, never product behaviour.
WAVE0_DB_MUTATE=""
WAVE0_MAX_SEED_USERS=""
WAVE0_TS_DOCS=""
WAVE0_TS_QUERIES=""
WAVE1A_MODES=""

PORT=4000
NODE_ENV="development"
