# Postgres (Neon) — see spotme/web's PUSH.md pattern: keys live in the host's
# env panel (Railway/Fly), never committed.
DATABASE_URL="postgresql://user:password@host/spotme?sslmode=require"

# Auth
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# OTP delivery (email channel to start — swap in an SMS provider later)
OTP_FROM_EMAIL="noreply@spotmemessenger.app"
RESEND_API_KEY=""

# Existing Cloudflare account (already used for TURN) — same login, new bucket.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="spotme-media"

# Push (unchanged targets from the mobile brief)
FCM_SERVICE_ACCOUNT_JSON=""
APNS_KEY_ID=""
APNS_TEAM_ID=""

# Age verification vendor (Nearby/Discovery gate only) — optional at launch
AGE_VERIFY_PROVIDER=""
AGE_VERIFY_API_KEY=""

# ── Notifications V2 platform (Priority 2) — ALL DEFAULT OFF ──────────────────
# With every flag unset the platform is inert and the app behaves exactly as
# before. Full table: docs/priority-2/flag-inventory.md.
NOTIFICATIONS_V2_ENABLED=""          # master switch (off)
NOTIF_OUTBOX_ENABLED=""              # route through the durable outbox+worker
# NOTIF_CLASS_MESSAGE, NOTIF_CLASS_CALL, … — per-class send flags (off)
# Encrypted rich payload — DO NOT enable without the ADR-008 §12 sign-off
# (docs/priority-2/security-review-encrypted-payload.md).
NOTIF_ENCRYPTED_PAYLOAD_ENABLED=""   # gated seal; off ⇒ builder throws, no key
# Direct APNs (VoIP/PushKit) — ordinary iOS uses the FCM relay regardless.
NOTIF_APNS_ENABLED=""
APNS_KEY=""                          # .p8 contents or a path to it
APNS_BUNDLE_ID=""                    # the APNs topic
# Aggregator/stub transports (never selected by default even when enabled):
NOTIF_DESKTOP_ENABLED=""
NOTIF_ONESIGNAL_ENABLED=""
NOTIF_NOVU_ENABLED=""

PORT=4000
NODE_ENV="development"
