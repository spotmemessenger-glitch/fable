{
  "name": "spotme-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Spot Me — client-server backend (auth, chat relay, moderation, admin API). Companion to spotme/web (P2P) and spotme/server (P2P relay peer) — this is the new server-tier rewrite.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed:employee": "node dist/scripts/seed-employee.js",
    "predeploy": "node -e \"const{cpSync,rmSync}=require('fs');rmSync('deploy-api',{recursive:true,force:true});cpSync('../web/api','deploy-api',{recursive:true});console.log('staged web/api -> deploy-api')\"",
    "deploy": "railway up --detach",
    "test": "jest",
    "postbuild": "node scripts/build-id.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/s3-request-presigner": "^3.1100.0",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/platform-socket.io": "^10.4.6",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/websockets": "^10.4.6",
    "@parse/node-apn": "^8.1.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cuid": "^3.0.0",
    "firebase-admin": "^14.2.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "argon2@0.41.1": true,
    "prisma@5.22.0": true
  },
  "overrides": {
    "multer": "^2.2.0",
    "lodash": "^4.18.1",
    "glob@10": "^10.5.0"
  }
}
