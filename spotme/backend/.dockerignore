# Keep the build context small and, more importantly, keep local secrets out of
# the image: production values come from the host's environment, never a file.
node_modules
dist
# .deploy is generated by `npm run deploy` and MUST reach the image — it holds
# the language handlers. Listed here as a reminder, deliberately not ignored.
.env
.env.*
!.env.example
*.log
test
.git
