# generated by `npm run predeploy` — a copy of ../web/api for the image
.deploy/

# LocalStorageAdapter's default root (STORAGE_LOCAL_DIR overrides it). These are
# users' encrypted attachments — ciphertext, but still their media, and it must
# never reach a commit. The adapter creates this on first upload, so without
# this line a `git add -A` after any local media test would ship it.
.media/
