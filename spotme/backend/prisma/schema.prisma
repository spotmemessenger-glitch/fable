// Spot Me — server-tier backend schema.
// Design constraint from the compliance review: the server never stores message
// plaintext or holds any key capable of decrypting it. See README.md.
//
// ONE DELIBERATE EXCEPTION (product decision, 2026-07-30): PUBLIC groups store
// their room key in Group.secretKey so a stranger who finds the group by
// @username can join instantly. The server can therefore decrypt public-group
// traffic. DMs and PRIVATE groups are unaffected and remain strictly E2E.
// This narrows the compliance claim above — it must be re-reviewed before any
// privacy statement repeats the unqualified version. See docs/GROUPS-BUILD.md.

generator client {
  provider = "prisma-client-js"
  // Pinned because auto-detection guessed wrong in the deploy image and the
  // container died at boot looking for libssl.so.1.1 — node:22-slim is
  // Debian bookworm (OpenSSL 3). "native" keeps local development working.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPPORT
  MODERATOR
  ADMIN
  OPS
}

enum RequestSource {
  NEARBY
  USERNAME
  LINK
  CONTACT
  BLUETOOTH
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ReportReason {
  HARASSMENT
  SPAM
  CSAM
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
  ESCALATED_NCMEC
}

enum Sex {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

// Ranked: OWNER > ADMIN > MODERATOR > MEMBER. Rank order is enforced in
// groups.service (canActOn) so nobody can act on a peer or a superior.
enum GroupRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum GroupVisibility {
  PRIVATE // invite-URL only; key lives in the URL fragment, never sent to the server
  PUBLIC  // discoverable by @username; server holds the key so joins are instant
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String?  @unique
  phone         String?  @unique
  name          String?
  avatarUrl     String?
  // X25519 public key (base64), used for NaCl box E2E encryption — safe to
  // store server-side and hand out via lookup, since it's a PUBLIC key.
  // The matching secret key lives only on the user's device.
  publicKey     String?
  // Self-reported, optional, used only for aggregate analytics — never combined
  // with a location history (none is kept; see Presence below).
  city          String?
  area          String?
  age           Int?
  sex           Sex      @default(UNSPECIFIED)
  ageVerified   Boolean  @default(false)
  ageVerifiedAt DateTime?
  ageVerifyRef  String? // third-party verification provider's reference id only
  // Wave 1B (owner decision D6): the self-declared birth YEAR-MONTH ('YYYY-MM')
  // behind the 18+ gate — deliberately never a full date of birth (data
  // minimization; see src/policy/age.ts). Immutable once set except via the
  // documented support path. NEVER selected into any API response or log; the
  // only age fact a client sees is the `ageVerified` boolean.
  birthYearMonth   String?
  // Version of the policy text shown when the declaration was made (B2).
  agePolicyVersion String?
  // Wave 1C (owner decision, D6 addendum): EXPLICIT account status — never a
  // side-effect of other fields. 'active' | 'frozen_minor'. A frozen account
  // keeps its data (read-only wind-down: can read existing conversations and
  // the policy notice; cannot start conversations, send, be messaged anew, or
  // reach any new surface). Reversal is the documented support path only.
  accountStatus    String  @default("active")

  passwordHash  String? // unset when the account only ever used OTP
  // SHA-256 of the device-held claim secret for guest (no-account) identities —
  // proves a re-auth or username release comes from the device that claimed it.
  claimSecretHash String?
  role          Role     @default(USER)

  createdAt     DateTime @default(now())
  deletedAt     DateTime? // soft-delete marker; hard-delete job purges after grace period
  uninstalledAt DateTime?

  devices          Device[]
  otpCodes         OtpCode[]
  refreshTokens    RefreshToken[]
  sentRequests     ChatRequest[]     @relation("RequestSender")
  receivedRequests ChatRequest[]     @relation("RequestRecipient")
  participants     ConversationParticipant[]
  reportsFiled     Report[]          @relation("ReportedBy")
  reportsAgainst   Report[]          @relation("ReportedUser")
  blocksMade       Block[]           @relation("Blocker")
  blocksReceived   Block[]           @relation("Blocked")
  presence         Presence?
  installEvents    InstallEvent[]
  groupsOwned      Group[]           @relation("GroupOwner")
  groupMemberships GroupMember[]
  deviceTokens     DeviceToken[]
  stories          Story[]
  storyViews       StoryView[]
  signingKeys      SigningKey[]
  signedPreKeys    SignedPreKey[]
  oneTimePreKeys   OneTimePreKey[]
  discoveryVisibility DiscoveryVisibility?
  discoveryProfile    DiscoveryPublicProfileProjection?
  exchangeIntents     ExchangeIntent[]  @relation("ExchangeIntentOwner")
  moments             Moment[]          @relation("MomentAuthor")
  momentStories       MomentStory[]     @relation("MomentStoryAuthor")

  @@index([city])
  @@index([createdAt])
}

// One row per user, overwritten on every update. No history table exists —
// this is the entire "location" footprint the server keeps.
model Presence {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat       Float?
  lon       Float?
  ghost     Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String   // ios | android | web
  pushToken   String?
  appVersion  String?
  installedAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([userId])
}

model InstallEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      String   // install | uninstall | first_open
  platform  String
  city      String?  // coarse, IP or self-reported at signup — never GPS-derived
  ts        DateTime @default(now())

  @@index([kind, ts])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  channel   String   // email | sms
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  deviceId  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Conversation {
  id        String   @id @default(cuid())
  kind      String   @default("dm") // dm | group
  title     String?
  createdAt DateTime @default(now())

  // 1 = e2e_v1 (key derived from both user ids via cyrb53 — the server can
  // recompute it; see ADR-001), 2 = e2e_v2 (X25519 ECDH + HKDF, device-held).
  // Default 1 backfills every existing row honestly: they ARE v1 and cannot be
  // migrated without destroying their history.
  //
  // NOTE FOR THE WEB APP: this column is NOT its source of truth. Web DM rooms
  // never create a Conversation row — they are roomId keys into RoomEvent /
  // RoomMember, and their version lives on the client convo record and in the
  // knock payload. This field serves the mobile/backend track (chat.service,
  // chat-requests.service) and keeps the two schemas legible to each other.
  keyVersion Int     @default(1)

  participants ConversationParticipant[]
  messages     Message[]
  chatRequest  ChatRequest?
  group        Group?
}

// A group rides the room transport: `roomId` is the same opaque id used by
// RoomEvent (ciphertext) and RoomMember, so message fan-out, history replay and
// read receipts work unchanged. This row is the metadata + authority layer —
// roles and permissions are enforced here, server-side, without the server ever
// needing to read message content.
//
// `conversationId` is the migration bridge to the retired /api/groups stack
// (Conversation + ConversationParticipant). Nullable because groups created
// after the unification never get one; it exists so ported rows keep their
// history. Drop it once the mobile/admin surfaces are fully migrated.
model Group {
  id        String  @id @default(cuid())
  roomId    String  @unique
  name      String
  avatarUrl String?

  // Set only for PUBLIC groups, and globally unique against User.username —
  // see AuthService.usernameCheck, which consults both tables so a group can
  // never shadow a person (or vice versa).
  username   String?         @unique
  visibility GroupVisibility @default(PRIVATE)

  // Room key, PUBLIC groups only. NULL for PRIVATE groups, whose key never
  // leaves the client. See the exception noted in this file's header.
  secretKey String?

  ownerId String
  owner   User   @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Defaults applied to MEMBER-role users. Elevated roles bypass these.
  membersCanAdd     Boolean @default(true)
  membersCanMessage Boolean @default(true)
  membersCanMedia   Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft delete: hidden immediately, purged by the 30-day job in groups.service.
  deletedAt DateTime?

  members GroupMember[]

  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([deletedAt])
}

// Membership + role + per-member grants. A row is kept after leaving (leftAt
// set) so joined/left history survives, which means every lookup must filter
// on leftAt: null — see GroupsService.requireMember.
model GroupMember {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role GroupRole @default(MEMBER)

  // Granular grants the Owner toggles per Admin/Moderator. All default false:
  // an elevated role confers nothing until it is explicitly granted.
  canAddAdmin       Boolean @default(false)
  canBan            Boolean @default(false)
  canMute           Boolean @default(false)
  canRemove         Boolean @default(false)
  canDeleteMessages Boolean @default(false)
  canControlInvites Boolean @default(false)

  mutedUntil DateTime?
  bannedAt   DateTime?

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, leftAt])
}

// 24h-expiry story. Text-only for now: media stories need the R2 upload
// pipeline (see backend README "still needs wiring"), so mediaKey stays
// unpopulated rather than faking a photo path with no storage behind it.
model Story {
  id          String      @id @default(cuid())
  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind        String      @default("text") // text | photo (photo needs R2, not wired yet)
  textContent String?
  mediaKey    String?
  createdAt   DateTime    @default(now())
  expiresAt   DateTime
  views       StoryView[]

  @@index([authorId, createdAt])
  @@index([expiresAt])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([storyId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  archived       Boolean      @default(false)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

// Ciphertext + metadata only. The server never has a key that opens `cipherText`.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  cipherText     String       // base64 NaCl box ciphertext, opaque to the server
  nonce          String?      // base64 nonce for the box above — public, not secret
  mediaKey       String?      // R2 object key, itself encrypted client-side before upload
  kind           String       @default("text") // text | image | voice | video | file | location
  ttlSeconds     Int?         // disappearing-message TTL, mirrors the current app
  sentAt         DateTime     @default(now())
  expiresAt      DateTime?

  @@index([conversationId, sentAt])
}

model ChatRequest {
  id             String        @id @default(cuid())
  fromUserId     String
  fromUser       User          @relation("RequestSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId       String
  toUser         User          @relation("RequestRecipient", fields: [toUserId], references: [id], onDelete: Cascade)
  source         RequestSource
  status         RequestStatus @default(PENDING)
  greeting       String?
  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  respondedAt    DateTime?
  expiresAt      DateTime

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

// The only path content ever reaches a human in readable form: the reporter's
// own client attaches plaintext at report time. Nothing is decrypted server-side.
model Report {
  id                String       @id @default(cuid())
  reporterId        String
  reporter          User         @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId    String
  reportedUser      User         @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reason            ReportReason
  status            ReportStatus @default(OPEN)
  reportedContent   String       // plaintext supplied by the reporter's client at report time
  contextNote       String?
  createdAt         DateTime     @default(now())
  resolvedAt        DateTime?
  resolvedByEmployeeId String?
  // 18 U.S.C. 2258A: preserve reported material + metadata for 90 days
  // (180 if law enforcement requests it) — enforced by a retention job, not by hand.
  retainUntil       DateTime
  ncmecReportedAt   DateTime?
  ncmecReportId     String?

  @@index([status, createdAt])
  @@index([reportedUserId])
}

model Block {
  id          String   @id @default(cuid())
  blockerId   String
  blocker     User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId   String
  blocked     User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// Staff accounts for the admin dashboard — deliberately separate from end-user
// accounts, even though it shares the Role enum.
model Employee {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(SUPPORT)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  auditEntries AuditLog[]
}

// Every sensitive dashboard action, logged — the accountability control GDPR
// expects in exchange for any staff access to user-adjacent data.
model AuditLog {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  action      String   // e.g. "report.view", "report.action", "employee.create"
  targetType  String?  // e.g. "Report", "User", "Employee"
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([employeeId, createdAt])
  @@index([action, createdAt])
}

// Server health samples, polled by the ops dashboard. A real deployment layers
// Sentry/host metrics on top of this later — this is the zero-dependency floor.
model HealthSample {
  id           String   @id @default(cuid())
  ts           DateTime @default(now())
  uptimeOk     Boolean
  errorCount   Int      @default(0)
  p95LatencyMs Int?
  note         String?

  @@index([ts])
}

// Transport-level event log for server-backed rooms (the web client's rooms
// become Socket.IO rooms whose persistent actions land here and replay on
// join). `payload` is AES-GCM ciphertext produced client-side from the room
// secret — the server never receives that secret, so this log is opaque.
// `id` doubles as the replay cursor: clients ask for events with id > since.
model RoomEvent {
  id        Int      @id @default(autoincrement())
  roomId    String
  type      String   // msg | react | profile | del | edit | read | seen | knock | knockAck | bin | binack
  senderId  String
  payload   Bytes
  meta      Json?    // cleartext routing only (attachment id/seq/total) — no content
  attachId  String?  // set on bin slices so fetch can serve an attachment by id
  createdAt DateTime @default(now())

  @@index([roomId, id])
  @@index([roomId, attachId])
}

// One row per view-once ("Private photo") attachment the server has been asked
// to hold. WHY IT EXISTS: RoomEvent has no expiry and the fetch endpoint used
// to serve any slice by attachId forever, so a "burned" photo was still
// downloadable by anyone who knew the room. The client cannot enforce that —
// only whoever holds the bytes can.
//
// attachId is the primary key so the first fetcher CLAIMS the view atomically:
// a concurrent second fetcher loses the insert and is refused. The row
// deliberately outlives the RoomEvent rows it guards, so a fetch after the
// burn is answered "gone" rather than "unknown".
model ViewOnce {
  attachId  String    @id
  roomId    String
  senderId  String
  viewerId  String?   // whoever claimed the single view; null until first fetch
  createdAt DateTime  @default(now())
  burnedAt  DateTime? // set when the slices were deleted — audit, not a gate

  @@index([roomId])
}

// A device's Web Push subscription. Endpoint is the natural key: browsers mint
// a new one per install, and re-subscribing after a permission reset produces
// a different endpoint rather than a duplicate of the old one.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// A native app's FCM/APNs registration token.
//
// Separate from PushSubscription because the two transports share nothing: Web
// Push addresses a browser endpoint with its own p256dh/auth keypair, while a
// native app has an opaque token minted by Google or Apple. They are also NOT
// interchangeable — Capacitor's Android WebView exposes no PushManager and no
// Notification API at all (verified on-device), so the packaged app can only
// ever be reached through this table, and a browser PWA only through the other.
model DeviceToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The natural key: a reinstall mints a new token, and re-registering the same
  // device must update one row rather than accumulate duplicates that would
  // each fire the same notification.
  token      String    @unique
  platform   String // android | ios
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// Who belongs to a room, so the server knows whom to notify when an event
// lands there. Rooms are opaque ids the server cannot decode — it learns
// membership from who joins, and that is the only reason this table exists.
model RoomMember {
  roomId   String
  userId   String
  joinedAt DateTime @default(now())
  lastSeen DateTime @updatedAt

  @@id([roomId, userId])
  @@index([userId])
}

model CrashReport {
  id           String   @id @default(cuid())
  platform     String   // ios | android | web
  appVersion   String?
  signature    String   // grouping key — top stack frame or error message
  message      String
  stackTrace   String?
  userId       String?
  ts           DateTime @default(now())

  @@index([signature, ts])
}

// The published SIGNING-key lifecycle (ADR-008 Phase 2B). A table, not a User
// column, because a trust anchor's history IS the product: the agreement key's
// single-column precedent is exactly what made its lifecycle unauditable — an
// overwrite leaves no trace, and "no key" and "never had a key" are the same
// NULL. Rows are NEVER deleted: a withdrawn key is a served tombstone, since a
// key that silently disappears is indistinguishable from one that never
// existed — the substituting server's preferred posture. At most one 'active'
// row per user, enforced transactionally in the service.
model SigningKey {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKeyB64       String
  algo               String // 'Ed25519' | 'ECDSA-P-256'
  status             String // 'active' | 'superseded' | 'withdrawn'
  createdAt          DateTime  @default(now())
  withdrawnAt        DateTime?
  // Supersession: the OLD key signs a length-prefixed transcript naming its
  // replacement; the signature is stored on the RETIRED row so the chain is
  // checkable by any client that fetches it.
  supersededById     String?
  supersessionSigB64 String?

  @@unique([userId, publicKeyB64])
  @@index([userId, status])
}

// X3DH prekey infrastructure (ADR-004 §8, e2e_v3). Additive and independent of
// the message path — no existing table changes. A bundle is what a peer fetches
// to open a session WITHOUT the recipient online: the signed prekey proves the
// bundle came from the identity (Ed25519 over IK||SPK, verified before any DH),
// and the one-time prekeys give the FIRST message forward secrecy.
//
// The identity key itself is NOT stored here — it is the published signing key
// (SigningKey) plus the X25519 agreement key (User.publicKey). This table holds
// only the rotating prekeys that hang off that identity.
model SignedPreKey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String   // 16-byte device id, hex — which device published this
  keyId        Int      // client-assigned, monotonic per device; names the SPK in a header (SPKID)
  pub          String   // raw X25519 public key, base64
  sig          String   // Ed25519 signature over (IK || SPK), base64 — verified by the fetcher
  createdAt    DateTime @default(now())
  // Exactly one active SPK per (user, device): rotation replaces, it does not
  // accumulate. Kept (not deleted) so in-flight initial messages naming an old
  // SPKID can still resolve until they expire.
  retiredAt    DateTime?

  @@unique([userId, deviceId, keyId])
  @@index([userId, deviceId])
}

// One-time prekeys — consumed ATOMICALLY and single-use. The server deletes the
// row in the same transaction that serves the bundle, so two fetchers never get
// the same OPKID. Exhaustion is not an error: the bundle is served without one
// (OPKID = 0xFFFFFFFF on the wire), weaker but functional, and the sentinel
// makes the degradation visible rather than silent.
model OneTimePreKey {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String
  keyId     Int      // names the OPK in a header (OPKID)
  pub       String   // raw X25519 public key, base64
  createdAt DateTime @default(now())

  @@unique([userId, deviceId, keyId])
  @@index([userId, deviceId])
}

// ---------------------------------------------------------------------------
// Smart Nearby Discovery Map (Platform Phase 2, checkpoint 3) — DARK.
// Additive tables only; minimum persistence for discovery. No precise GPS
// (coarse cell + coarse point only, produced on-device — ADR-018/019/024).
// No sensitive attribute is projected (P6/A3: no age, no gender). The
// canonical user profile is NOT duplicated — the projection holds approved
// public fields only and is derived, rebuildable, and deleted with the user
// (A9; FK ON DELETE CASCADE).

/// My discovery presence/visibility (P3: opt-in, reversible, auto-expiring).
model DiscoveryVisibility {
  userId            String   @id
  enabled           Boolean  @default(false)
  /// Coarse privacy-cell identifier (ADR-018); opaque.
  coarseCell        String
  /// Coarse public point ONLY — the on-device approximation, never a fix.
  coarseLat         Float
  coarseLon         Float
  /// PostGIS geography for spatial indexing; written by the repository from
  /// (coarseLon, coarseLat) — same coarse data, spatially indexable.
  geog              Unsupported("geography(Point, 4326)")?
  updatedAt         DateTime @updatedAt
  /// Presence expires; expired rows are unqueryable (threat model C-EXPIRE).
  expiresAt         DateTime
  /// Monotonic — realtime consumers drop stale versions (C-REPLAY).
  visibilityVersion Int      @default(1)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([enabled, expiresAt])
}

/// Approved PUBLIC projection for discovery. References the canonical handle
/// but is NEVER the authority for handle uniqueness/ownership/lifecycle (A9)
/// — hence no unique constraint here; the identity model stays authoritative.
model DiscoveryPublicProfileProjection {
  userId           String   @id
  handle           String?
  /// Normalized (lowercased/folded) search projection of the handle.
  normalizedHandle String?
  displayName      String
  avatarRef        String?
  discoverable     Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([normalizedHandle])
  @@index([discoverable])
}

/// Block projection for discovery-time filtering, BOTH directions indexed
/// (threat model C-BLOCK). Derived from the canonical Block model; kept as a
/// projection so discovery queries never join the full social graph.
model DiscoveryBlockProjection {
  ownerUserId   String
  blockedUserId String
  createdAt     DateTime @default(now())

  @@id([ownerUserId, blockedUserId])
  @@index([blockedUserId])
}

// ============================================================================
// SpotMe Exchange (Platform Phase 3B) — DARK.
//
// ADDITIVE ONLY. No existing model is touched. The ExchangeModule that reads
// these tables is NOT imported by AppModule — nothing reaches them until an
// owner-authorized activation change. Locations are the on-device COARSE public
// position only (ADR-018/019) — never a precise fix. No age/gender/sensitive
// column exists (A3). No payment/escrow column exists; an informational price
// is a display label only. Business participation is a DARK SEAM (D4): the
// table exists but no business flow is reachable — v1 posture is individuals-only.
// ============================================================================

/// An Exchange intent (need / offer / service). Coarse location + geography for
/// spatial matching; keyset-paginated; expiry makes stale intents unqueryable.
model ExchangeIntent {
  id                    String   @id @default(cuid())
  ownerId               String
  /// 'user' | 'business' — a REFERENCE to canonical identity; Exchange owns no
  /// identity lifecycle (A9). Business is a dark seam (D4).
  ownerKind             String   @default("user")
  /// 'need' | 'offer' | 'service'
  kind                  String
  /// draft|active|paused|matched|fulfilled|expired|withdrawn|removed
  status                String   @default("draft")
  category              String
  title                 String
  text                  String
  tags                  String[]
  budgetBand            String?
  /// Display-only price label; NOT a payment field.
  informationalPrice    String?
  /// 'window' | 'recurring' | 'unknown'
  availabilityState     String   @default("unknown")
  availabilityFrom      DateTime?
  availabilityTo        DateTime?
  availabilitySchedule  String?
  /// Coarse public point ONLY (ADR-018); never a precise fix.
  coarseLat             Float
  coarseLon             Float
  coarseCell            String
  /// PostGIS geography for spatial matching; written from the coarse point.
  geog                  Unsupported("geography(Point, 4326)")?
  radiusKm              Float    @default(5)
  maxRadiusKm           Float    @default(25)
  /// 'hidden' | 'discoverable'
  visibility            String   @default("hidden")
  /// 'clear' | 'pending-review' | 'restricted' | 'removed'
  moderationState       String   @default("clear")
  /// Optimistic concurrency — bumped on every mutation.
  versionSeq            Int      @default(1)
  /// Client-supplied idempotency key, unique per owner (replay-safe mutations).
  idempotencyKey        String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  expiresAt             DateTime?
  owner                 User     @relation("ExchangeIntentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  lifecycle             ExchangeLifecycleEvent[]
  matchesAsNeed         ExchangeMatchProjection[] @relation("ExchangeMatchNeed")
  matchesAsOffer        ExchangeMatchProjection[] @relation("ExchangeMatchOffer")

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, status])
  @@index([kind, status])
  @@index([status, expiresAt])
  @@index([expiresAt])
}

/// Sanitized PUBLIC projection for search/index — labels only, NEVER
/// coordinates, private profile, message content, or age/gender (threat model
/// T-EX-19). Derived, rebuildable, deleted with the intent.
model ExchangeSearchProjection {
  intentId         String   @id
  kind             String
  category         String
  title            String
  /// Normalized (folded) searchable text projection.
  normalizedText   String
  /// Authorized intent labels (future Exchange-compatible), never free PII.
  intentLabels     String[]
  /// Coarse cell only — discretized, never a precise point.
  coarseCell       String
  updatedAt        DateTime @updatedAt

  @@index([kind, category])
}

/// Append-only lifecycle audit. Closed reason codes only — no free text.
model ExchangeLifecycleEvent {
  id          String   @id @default(cuid())
  intentId    String
  fromStatus  String
  toStatus    String
  /// 'owner' | 'moderation' | 'system-expiry'
  byKind      String
  /// owner-action|ttl|moderation-removed|fulfilled-confirmed|superseded
  reasonCode  String?
  createdAt   DateTime @default(now())
  intent      ExchangeIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([intentId, createdAt])
}

/// Match projection between a need and an offer (supersede-guarded via epoch).
model ExchangeMatchProjection {
  id            String   @id @default(cuid())
  needId        String
  offerId       String
  /// proposed|viewed|accepted|declined|dismissed|superseded|expired
  status        String   @default("proposed")
  score         Float
  epoch         Int      @default(1)
  /// Distance is a BAND — never metres between two parties.
  distanceBand  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  need          ExchangeIntent @relation("ExchangeMatchNeed", fields: [needId], references: [id], onDelete: Cascade)
  offer         ExchangeIntent @relation("ExchangeMatchOffer", fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([needId, offerId])
  @@index([needId, status, score])
  @@index([offerId, status])
}

/// Business participation — DARK SEAM ONLY (D4). The table exists so the
/// contract is complete, but NO business flow is reachable in v1 (individuals
/// only). Never authoritative for identity.
model ExchangeBusinessParticipation {
  businessId      String   @id
  displayName     String
  verified        Boolean  @default(false)
  categoryLabels  String[]
  coarseCell      String?
  updatedAt       DateTime @updatedAt
}

/// ─────────────────────────────────────────────────────────────────────────
/// Live Nearby Events (Platform Phase 4B) — DARK. `EventsModule` is NOT imported
/// by `AppModule`; no `/v1/events` route exists until an owner-gated activation.
/// All models are additive; no existing table is touched. Instants are stored as
/// UTC `DateTime` and surfaced as epoch-ms at the boundary; the source timezone
/// is preserved for display only. Raw provider payloads are NEVER persisted.
/// ─────────────────────────────────────────────────────────────────────────

/// A stored public event from a provider feed. Location is the COARSE public
/// venue point only (never a precise fix); there is no user-origin column.
model Event {
  /// `${provider}:${providerEventId}`.
  id                String    @id
  provider          String
  providerEventId   String
  providerSourceId  String?
  /// Canonical organizer reference (stable across a provider's events).
  organizerRef      String?
  sourceName        String?
  url               String?
  /// Source's last revision/update instant.
  revisionAt        DateTime?
  /// Source-supplied confidence 0..1; null = unknown.
  confidence        Float?
  category          String    @default("other")
  title             String
  description       String?
  /// UTC instants; null = tbd (e.g. postponed). end < start is rejected before write.
  startAt           DateTime?
  endAt             DateTime?
  /// IANA timezone id, preserved for DISPLAY only.
  timezone          String?
  allDay            Boolean   @default(false)
  /// Recurrence occurrence id — PROVIDER-SUPPLIED ONLY, never inferred.
  occurrenceId      String?
  /// scheduled|cancelled|postponed (source-asserted; overrides the clock).
  lifecycle         String    @default("scheduled")
  /// Provenance for a source-asserted cancel/postpone.
  provenanceBy      String?
  provenanceAt      DateTime?
  provenanceNote    String?
  /// Coarse public venue point ONLY; never a precise fix.
  coarseLat         Float
  coarseLon         Float
  coarseCell        String
  /// PostGIS geography for spatial queries; written from the coarse point.
  geog              Unsupported("geography(Point, 4326)")?
  /// Sourced popularity 0..1; null = unknown (ranks as omitted, never invented).
  popularity        Float?
  /// Dedup: the canonical event id this row folds into (null/self = canonical).
  canonicalId       String?
  /// Retrieval instant (freshness).
  fetchedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  /// Retention sweep target (ended + retention window).
  expiresAt         DateTime?

  @@unique([provider, providerEventId])
  @@index([canonicalId])
  @@index([startAt])
  @@index([coarseCell])
}

/// An EXPLAINABLE dedup decision (C4). Exact provider identity folds
/// automatically; a cross-provider merge records the evidence that justified it.
model EventDedupDecision {
  id           String   @id @default(cuid())
  /// The surviving canonical event id.
  canonicalId  String
  /// The event id folded into the canonical.
  mergedId     String
  /// exact-provider-identity | cross-provider-match
  basis        String
  /// Cross-provider evidence — ALL four must hold to merge; carried for audit.
  titleMatch   Boolean  @default(false)
  venueMatch   Boolean  @default(false)
  timeOverlap  Boolean  @default(false)
  areaMatch    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([mergedId])
  @@index([canonicalId])
}

/// Sanitized public search projection — labels + coarse cell only, NEVER
/// coordinates or raw payload (T-EV-5/6). Rebuildable from Event.
model EventSearchProjection {
  /// The event id.
  id             String    @id
  category       String
  title          String
  normalizedText String
  /// Coarse cell ONLY — no lat/lon field exists on the projection.
  coarseCell     String
  startAt        DateTime?
  /// Derived state at projection time (upcoming|happening-now|ended|cancelled|postponed).
  state          String
  updatedAt      DateTime  @updatedAt

  @@index([category, startAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// Nearby Moments — media assets (Platform Phase 5B) — DARK. MediaModule is NOT
/// imported by AppModule. Only METADATA-STRIPPED bytes are ever persisted
/// (exif-strip boundary); originals never touch storage. Content-hash dedup;
/// refCount-driven deletion cascade (5C moments hold the references).
/// ─────────────────────────────────────────────────────────────────────────
model MomentMediaAsset {
  id           String    @id @default(cuid())
  /// image | video
  kind         String
  mimeType     String
  sizeBytes    Int       @default(0)
  /// sha256 of the STRIPPED bytes — dedup key.
  contentHash  String    @unique
  /// Object key on the Phase 1 storage seam (IStorageAdapter).
  storageKey   String
  thumbnailKey String?
  width        Int?
  height       Int?
  durationMs   Int?
  /// References held by moments/stories; asset deletes when this hits zero.
  refCount     Int       @default(0)
  /// INVARIANT: true always — only stripped bytes are persisted.
  exifStripped Boolean   @default(true)
  createdAt    DateTime  @default(now())
  /// Story retention stamp (24h [PROPOSED]); null for regular post media.
  expiresAt    DateTime?
}

/// ─────────────────────────────────────────────────────────────────────────
/// Nearby Moments (Platform Phase 5C) — DARK. MomentsModule is NOT imported by
/// AppModule. PRIVACY (M5/ADR-028): location is an OPT-IN coarse cell on
/// nearby/public posts only — never a precise fix, and there is NO viewer/
/// origin column anywhere. 'private' posts never enter any feed query (SQL
/// carries the tier filter). No engagement counters are stored per-viewer.
/// ─────────────────────────────────────────────────────────────────────────

model Moment {
  id              String    @id @default(cuid())
  authorId        String
  /// photo | video | text
  kind            String
  text            String?
  /// MomentMediaAsset ids (refCount managed by the media service).
  mediaIds        String[]
  /// private | friends | nearby | public (M5; per-post, poster-controlled)
  visibility      String    @default("private")
  /// Poster-opted COARSE attach — nearby/public tiers only (ADR-028 §2).
  coarseLat       Float?
  coarseLon       Float?
  coarseCell      String?
  /// Server-derived 1-decimal (~11 km) city cell — never finer.
  cityCell        String?
  geog            Unsupported("geography(Point, 4326)")?
  /// visible | reported | limited | removed
  moderationState String    @default("visible")
  versionSeq      Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  author          User      @relation("MomentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments        MomentComment[]
  reactions       MomentReactionRow[]

  @@index([authorId, createdAt])
  @@index([cityCell])
  @@index([visibility, moderationState])
}

/// 24h stories (M3 six-state lifecycle). Named MomentStory — the legacy
/// client-E2E `Story` model (ciphertext stories) is untouched and unrelated.
model MomentStory {
  id              String   @id @default(cuid())
  authorId        String
  mediaId         String
  /// friends | nearby | public (private stories are unrepresentable)
  visibility      String   @default("friends")
  /// active | expired | deleted | archived | hidden | moderation-hidden (M3)
  state           String   @default("active")
  versionSeq      Int      @default(1)
  createdAt       DateTime @default(now())
  /// 24h from publish ([PROPOSED]); the {story-expiry} sweep flips state.
  expiresAt       DateTime
  author          User     @relation("MomentStoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([state, expiresAt])
  @@index([authorId, state])
}

/// Flat, parent-REFERENCED comments (M4) — nesting is render-side only.
model MomentComment {
  id              String   @id @default(cuid())
  momentId        String
  /// Parent comment id or null; NEVER nested storage (M4).
  parentId        String?
  authorId        String
  text            String
  /// visible | reported | limited | removed
  moderationState String   @default("visible")
  createdAt       DateTime @default(now())
  moment          Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@index([momentId, createdAt])
}

/// One reaction per (moment, user); the registry is CLOSED (M4) — service +
/// a raw CHECK constraint both enforce membership.
model MomentReactionRow {
  momentId  String
  userId    String
  /// like | love | laugh | wow | support (closed, M4)
  reaction  String
  createdAt DateTime @default(now())
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@id([momentId, userId])
}

/// Explicit follows (M2 'explicitFollows' signal + the friends feed source).
model MomentFollow {
  followerId String
  targetId   String
  createdAt  DateTime @default(now())

  @@id([followerId, targetId])
  @@index([targetId])
}

/// Two-way block: either direction removes content from every read path.
model MomentBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// Sanitized reports (ids + closed reason codes; note optional, bounded).
model MomentReport {
  id         String   @id @default(cuid())
  reporterId String
  /// moment | comment | story
  targetKind String
  targetId   String
  reason     String
  note       String?
  /// open | actioned | dismissed
  status     String   @default("open")
  createdAt  DateTime @default(now())

  @@index([targetKind, targetId])
  @@index([reason, status])
}

/// Append-only, SANITIZED moderation audit (ids + closed codes, never content).
model MomentModerationEvent {
  id         String   @id @default(cuid())
  targetKind String
  targetId   String
  fromState  String
  toState    String
  reason     String?
  /// reporter | moderation | system
  byKind     String
  createdAt  DateTime @default(now())

  @@index([targetId, createdAt])
}

/// WAVE-1A R7 — the activation kill-switch registry. One row per dark domain
/// (discovery, exchange, events, moments, assistant). MISSING ROW == DISABLED:
/// the gate fails dark, so a domain that was never flipped on cannot answer.
/// Flipping is ONE row UPDATE — no migration, no redeploy, no restart — and the
/// gate's short cache makes rollback-to-dark propagate in seconds (R7 bar: <60s).
model RuntimeFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt
}

/// WAVE-1C C7 — the Stage-A allowlist. INDEPENDENT of RuntimeFlag: a domain can
/// be served to a specific, auditable set of accounts while its RuntimeFlag row
/// stays absent (the production posture). Composite (domain,userId) is an EXACT
/// match — no wildcards. `note` + `addedAt` make every entry auditable; deleting
/// the row is the trivial removal. Empty table == nobody allowlisted.
model DomainAllowlist {
  domain  String
  userId  String
  note    String?
  addedAt DateTime @default(now())

  @@id([domain, userId])
  @@index([domain])
}
