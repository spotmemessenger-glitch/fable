{
  "name": "@spotme/web-next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "React + TypeScript strangler beachhead. Inert, NOT deployed, NOT referenced by spotme/web, excluded from the Vercel build. Proves the shared @spotme/contracts types render in a React surface.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:map-artifact": "node scripts/check-map-artifact.mjs",
    "test": "npm run check:boundaries && npm run typecheck && npm run test:unit && npm run build && npm run check:map-artifact",
    "preview": "vite preview",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "maplibre-gl": "^6.1.0",
    "pmtiles": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^4.1.10"
  }
}
